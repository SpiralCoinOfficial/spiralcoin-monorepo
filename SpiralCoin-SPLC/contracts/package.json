{
  "name": "contracts",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "compile:solcjs": "rm -rf artifacts-solcjs && solcjs --base-path . --include-path node_modules --optimize --abi --bin contracts/SpiralCoin.sol -o artifacts-solcjs",
    "compile": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy-multichain.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy-multichain.js --network mainnet",
    "deploy:bsc": "hardhat run scripts/deploy-multichain.js --network bsc",
    "deploy:bsc-testnet": "hardhat run scripts/deploy-multichain.js --network bscTestnet",
    "deploy:base": "hardhat run scripts/deploy-multichain.js --network base",
    "deploy:base-sepolia": "hardhat run scripts/deploy-multichain.js --network baseSepolia",
    "deploy:arbitrum": "hardhat run scripts/deploy-multichain.js --network arbitrum",
    "deploy:arbitrum-sepolia": "hardhat run scripts/deploy-multichain.js --network arbitrumSepolia",
    "deploy:polygon": "hardhat run scripts/deploy-multichain.js --network polygon",
    "deploy:polygon-amoy": "hardhat run scripts/deploy-multichain.js --network polygonAmoy",
    "deploy:optimism": "hardhat run scripts/deploy-multichain.js --network optimism",
    "deploy:optimism-sepolia": "hardhat run scripts/deploy-multichain.js --network optimismSepolia",
    "deploy:aa": "node scripts/deploy-aa.js",
    "deploy:aa:dryrun": "cross-env AA_DRY_RUN=1 node scripts/deploy-aa.js",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "find:funded": "hardhat run scripts/find-funded-contracts.js",
    "validate-env": "node scripts/validate-env.js",
    "validate-env:mainnet": "node scripts/validate-env.js --mainnet",
    "dryrun:mainnet": "hardhat run scripts/dryrun-mainnet.js --network hardhat",
    "preflight:mainnet": "node scripts/validate-env.js --mainnet && hardhat compile && hardhat test && hardhat run scripts/dryrun-mainnet.js --network hardhat",
    "test": "hardhat test"
  },
  "keywords": [ ],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@openzeppelin/upgrades-core": "^1.44.2",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.0",
    "patch-package": "^8.0.1",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.7.0",
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.168",
    "@layerzerolabs/lz-evm-oapp-v2": "^3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.168",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@layerzerolabs/oapp-evm-upgradeable": "^0.1.3",
    "@layerzerolabs/oft-evm": "^3.2.1",
    "@layerzerolabs/oft-evm-upgradeable": "^3.2.1",
    "@nomicfoundation/edr": "^0.11.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "permissionless": "^0.2.30",
    "viem": "^2.21.0"
  },
  "overrides": {
    "ws": "^8.18.0",
    "undici": "^6.21.2",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.4",
    "uuid": "^11.1.1",
    "cookie": "^0.7.2",
    "js-cookie": "^3.0.6",
    "elliptic": "^6.6.1",
    "secp256k1": "^5.0.1",
    "cross-spawn": "^7.0.6",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "axios": "^1.8.2",
    "follow-redirects": "^1.15.6",
    "ip": "^2.0.1",
    "ethereum-cryptography": "^2.2.1"
  }
}
