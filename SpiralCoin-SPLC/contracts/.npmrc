# npm configuration for this package.
# legacy-peer-deps is required because @layerzerolabs packages declare
# peer dependencies that conflict with each other under npm's strict
# peer-dep resolver. This setting makes npm use the npm v6 resolution
# algorithm (install peers as needed, warn but don't error on conflicts).
# This file is also read by the crytic/slither-action Docker container
# when it runs `npm ci` inside the container, ensuring the install does
# not fail before Slither can analyze the contracts.
legacy-peer-deps=true
